# Gadget Price Tracker — Environment Variable Template
#
# This file is SAFE to commit. It contains no real secrets — only variable
# names and dummy/empty values so collaborators know what to fill in.
#
# Setup instructions:
#   1. Create a Supabase project at https://supabase.com
#   2. Go to Project Settings → API
#   3. Copy your Project URL and anon/public key
#   4. Create a .env.local file (see .env for format) and paste the real values there
#   5. Never commit .env or .env.local
#
# Run the SQL from the Supabase Setup modal inside the app to create the
# price_entries table and open RLS policies.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
