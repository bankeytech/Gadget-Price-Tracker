dist
dist-ssr
.next
out
build

# =============================================================================
# Environment variables — NEVER commit these
# =============================================================================
# All .env* files are ignored EXCEPT .env.example (tracked as a safe template)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow the example file (override the wildcard above if needed)
!.env.example

